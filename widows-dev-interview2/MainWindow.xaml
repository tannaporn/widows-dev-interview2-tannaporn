<Window x:Class="widows_dev_interview2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="widows-dev-interview2 — NASA APOD" Width="1100" Height="760" MinWidth="600" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="#F1F5F9" FontFamily="Leelawadee UI, Segoe UI"
        FontSize="14" Foreground="#172B4D" SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#17365D" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#2563EB" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#2563EB" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.8" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" /><Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#1D4ED8" /><Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#1D4ED8" />
        </Style>
        <Style x:Key="DetailText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" /><Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" /><Setter Property="SelectionBrush" Value="#93C5FD" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="34" /><Setter Property="Padding" Value="8,4" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="#102542" Padding="20,14">
            <StackPanel>
                <TextBlock Text="ภาพดาราศาสตร์ประจำวัน" Foreground="White" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="NASA APOD · เลือกเดือน แล้วสำรวจเรื่องราวจากอวกาศ" Foreground="#C7DBF4"
                           Margin="0,3,0,0" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="1" Margin="20,10,20,8">
            <WrapPanel>
                <TextBlock x:Name="ApiKeyStatusText" Text="ยังไม่มี API key" VerticalAlignment="Center" Margin="0,0,16,6" />
                <Button x:Name="EditApiKeyButton" Content="เพิ่ม key" Click="EditKey_Click" Margin="0,0,8,6" />
                <Button x:Name="DeleteApiKeyButton" Content="ลบ key" Click="DeleteKey_Click" Margin="0,0,0,6" IsEnabled="False" />
            </WrapPanel>
            <WrapPanel>
                <StackPanel Margin="0,0,10,0">
                    <Label Content="เดือน" Target="{Binding ElementName=MonthSelector}" Padding="0,0,0,4" FontSize="12" />
                    <ComboBox x:Name="MonthSelector" Width="145" SelectionChanged="DateChanged" AutomationProperties.Name="เดือนที่ต้องการดู" />
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <Label Content="ปี ค.ศ." Target="{Binding ElementName=YearSelector}" Padding="0,0,0,4" FontSize="12" />
                    <ComboBox x:Name="YearSelector" Width="95" SelectionChanged="DateChanged" AutomationProperties.Name="ปีคริสต์ศักราชที่ต้องการดู" />
                </StackPanel>
                <Button x:Name="LoadButton" Content="โหลดข้อมูล" Style="{StaticResource PrimaryButton}"
                        Margin="0,22,10,0" VerticalAlignment="Top" Click="LoadData_Click" IsEnabled="False" />
                <Button x:Name="CancelButton" Content="ยกเลิก" Margin="0,22,0,0" VerticalAlignment="Top" Click="CancelLoad_Click" IsEnabled="False" />
            </WrapPanel>
        </StackPanel>
        <Border x:Name="StatusBorder" Grid.Row="2" Background="#E8F0FC" Padding="12,8" Margin="20,0,20,10" CornerRadius="5">
            <StackPanel>
                <TextBlock x:Name="StatusText" Text="เพิ่ม API key แล้วกดโหลดข้อมูลเพื่อเริ่มต้น" TextWrapping="Wrap"
                           Foreground="#17365D" AutomationProperties.LiveSetting="Polite" />
                <ProgressBar x:Name="LoadingProgress" Height="3" IsIndeterminate="True" Visibility="Collapsed"
                             Margin="0,8,0,0" Foreground="#2563EB" AutomationProperties.Name="กำลังโหลดข้อมูล" />
            </StackPanel>
        </Border>
        <Grid x:Name="ContentGrid" Grid.Row="3" Margin="20,0,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumn" Width="320" /><ColumnDefinition x:Name="GapColumn" Width="16" />
                <ColumnDefinition x:Name="DetailsColumn" Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="ListRow" Height="*" /><RowDefinition x:Name="GapRow" Height="0" />
                <RowDefinition x:Name="DetailsRow" Height="0" />
            </Grid.RowDefinitions>
            <Border x:Name="ListPanel" Background="White" BorderBrush="#DCE4EE" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel Margin="14,10,14,8">
                        <TextBlock Text="รายการ" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="DisplayedPeriodText" Text="ยังไม่มีข้อมูล" Foreground="#526680" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <ListBox x:Name="EntriesList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             SelectionChanged="ItemSelected" AutomationProperties.Name="รายการภาพดาราศาสตร์">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="8" /><Setter Property="Margin" Value="3,0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="44" ToolTip="{Binding Title}" />
                                    <TextBlock Text="{Binding DateText}" Foreground="#526680" FontSize="12" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding MediaLabel}" Foreground="#1D4ED8" FontSize="11" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel x:Name="ListEmptyPanel" Grid.Row="1" VerticalAlignment="Center" Margin="18">
                        <TextBlock x:Name="ListEmptyTitle" Text="ยังไม่มีรายการ" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock x:Name="ListEmptyMessage" Text="เลือกเดือนและกดโหลดข้อมูล" TextAlignment="Center" TextWrapping="Wrap" Foreground="#526680" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border x:Name="DetailsPanel" Grid.Column="2" Background="White" BorderBrush="#DCE4EE" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <TextBlock x:Name="NoSelectionText" Text="เลือกรายการเพื่ออ่านรายละเอียด" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#526680" TextWrapping="Wrap" />
                    <ScrollViewer x:Name="DetailsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="DetailDateText" Foreground="#526680" FontSize="12" Margin="0,0,0,5" />
                            <TextBox x:Name="DetailTitleText" Style="{StaticResource DetailText}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,14" AutomationProperties.Name="ชื่อรายการ" />
                            <Border x:Name="DetailImageFrame" Height="240" Background="#102542" CornerRadius="6">
                                <Grid>
                                    <TextBlock x:Name="DetailImagePlaceholder" Text="ไม่มีภาพตัวอย่าง" Foreground="#D7E6F8"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" TextWrapping="Wrap" TextAlignment="Center" />
                                    <Image x:Name="DetailImage" Stretch="Uniform" Visibility="Collapsed" AutomationProperties.Name="ภาพของรายการที่เลือก" />
                                </Grid>
                            </Border>
                            <WrapPanel Margin="0,10,0,0">
                                <Button x:Name="OriginalMediaButton" Content="เปิดสื่อต้นฉบับ" Margin="0,0,8,6" Click="OpenMedia_Click" />
                                <Button x:Name="HighResolutionButton" Content="ภาพความละเอียดสูง" Margin="0,0,0,6" Click="OpenMedia_Click" />
                            </WrapPanel>
                            <TextBlock Text="คำอธิบาย" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,8" />
                            <TextBox x:Name="ExplanationText" Style="{StaticResource DetailText}" AutomationProperties.Name="คำอธิบายฉบับเต็ม" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <TextBlock x:Name="EasternDateText" Grid.Row="4" Margin="20,8,20,10" Foreground="#526680" FontSize="11" TextWrapping="Wrap" />
    </Grid>
</Window>
