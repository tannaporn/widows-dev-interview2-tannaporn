<Window x:Class="widows_dev_interview2.Views.KeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="จัดการ API key" Width="460" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#F1F5F9" FontFamily="Leelawadee UI, Segoe UI" FontSize="14"
        Foreground="#172B4D" Loaded="Window_Loaded">
    <StackPanel Margin="24">
        <TextBlock Text="NASA API key" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Text="บันทึก key ไว้ใช้ครั้งถัดไป โดยยังไม่เรียก API จนกว่าจะกดโหลดข้อมูล"
                   TextWrapping="Wrap" Foreground="#526680" Margin="0,8,0,16" />
        <Label Content="API key" Target="{Binding ElementName=ApiKeyInput}" Padding="0,0,0,6" />
        <PasswordBox x:Name="ApiKeyInput" Padding="10,8" MinHeight="38" AutomationProperties.Name="API key แบบปิดบัง" />
        <Button Content="นำเข้าจาก NASA_API_KEY" Click="ImportKey_Click"
                HorizontalAlignment="Left" Padding="12,7" Margin="0,12,0,0" />
        <TextBlock x:Name="KeyMessageText" TextWrapping="Wrap" Foreground="#B91C1C" Margin="0,12,0,0"
                   Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
        <TextBlock Text="จัดเก็บใน appsettings.json ภายในโฟลเดอร์ส่วนตัวของแอป"
                   FontSize="12" Foreground="#526680" TextWrapping="Wrap" Margin="0,16,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="ยกเลิก" IsCancel="True" Padding="14,7" Margin="0,0,8,0" />
            <Button Content="บันทึก key" IsDefault="True" Click="SaveKey_Click" Padding="14,7"
                    Background="#1D4ED8" Foreground="White" />
        </StackPanel>
    </StackPanel>
</Window>
